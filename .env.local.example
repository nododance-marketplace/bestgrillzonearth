# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Stripe — get from https://dashboard.stripe.com/test/apikeys
# Use TEST keys (pk_test_..., sk_test_...) for development; switch to LIVE
# keys (pk_live_..., sk_live_...) on Vercel for production.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Webhook signing secret — get from Stripe CLI (`stripe listen`) for local
# dev, or from the webhook endpoint settings in the Stripe dashboard for
# production. Required to verify webhook signatures in production.
STRIPE_WEBHOOK_SECRET=

# Public site URL — required only in production (Vercel). Used to build
# Stripe Checkout success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=

# Email that order notifications go to (informational; Stripe also sends
# its own merchant notifications to the account owner email).
ORDER_NOTIFICATION_EMAIL=
